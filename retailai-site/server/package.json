{
  "name": "retailai-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend proxy for the RetailAI site — bridges the browser to Azure AI Foundry Agents.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "configure:knowledge": "node configure-agent-knowledge.js",
    "configure:knowledge:dry-run": "node configure-agent-knowledge.js --dry-run",
    "test": "node --test"
  },
  "dependencies": {
    "@azure/ai-agents": "^1.1.0",
    "@azure/identity": "^4.4.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
