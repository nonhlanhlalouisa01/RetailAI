# Azure AI Foundry project endpoint (no trailing slash)
AZURE_AI_PROJECT_ENDPOINT=https://retailaichatbot.services.ai.azure.com/api/projects/RetailAIProject

# Foundry Agents REST API version
AZURE_AI_API_VERSION=v1

# Agent IDs — replace with the actual asst_... IDs from your Foundry project.
# If you only have a Concierge agent, leave the others blank and everything
# will fall back to the Concierge.
AGENT_CONCIERGE=
AGENT_CAMPAIGN=
AGENT_SENTIMENT=
AGENT_ANALYTICS=
AGENT_PORTFOLIO=

# Optional: API-key auth instead of Entra ID. Leave blank to use DefaultAzureCredential
# for named Responses agents. Persistent asst_... agents always use Entra ID.
AZURE_AI_API_KEY=

# Meta webhook for owned Facebook Pages and professional Instagram accounts.
# Keep these server-side. The verify token is a random value you choose.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Bearer token for an approved TikTok or licensed social-listening connector.
SOCIAL_INGEST_TOKEN=

# Recent normalized signals retained in memory (1-10000).
SOCIAL_SIGNAL_LIMIT=500

# Optional generated demo feed. Synthetic rows are clearly labeled and are not
# real customer posts. Set to true only in development or demonstration environments.
SYNTHETIC_SOCIAL_ENABLED=false
SYNTHETIC_SOCIAL_INITIAL_COUNT=18
SYNTHETIC_SOCIAL_INTERVAL_MS=10000
SYNTHETIC_SOCIAL_BATCH_SIZE=2

# Server port
PORT=3000
